PORT=3000
DOKPLOY_URL=https://dokploy.example.com
DOKPLOY_API_KEY=
GITHUB_TOKEN=
# Même secret dans Dokploy : Authorization: Bearer <secret>
WEBHOOK_SECRET=
CONFIG_FILE=./config.json
STATE_FILE=./data/state.json
# Rattrape les notifications manquées. 0 désactive cette synchronisation.
SYNC_INTERVAL_SECONDS=300
# true pour consulter Dokploy sans écrire dans GitHub ni dans le fichier d'état.
DRY_RUN=true
